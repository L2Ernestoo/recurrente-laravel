{
    "name": "arrendales/recurrente-laravel",
    "description": "SDK no oficial de Recurrente (pasarela de pagos de Guatemala) para Laravel: checkouts, suscripciones, productos y verificación de webhooks.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/L2Ernestoo/recurrente-laravel",
    "keywords": [
        "recurrente",
        "laravel",
        "payments",
        "guatemala",
        "checkout",
        "subscriptions",
        "webhooks"
    ],
    "authors": [
        {
            "name": "ArrendaLes"
        }
    ],
    "support": {
        "issues": "https://github.com/L2Ernestoo/recurrente-laravel/issues",
        "source": "https://github.com/L2Ernestoo/recurrente-laravel"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Recurrente\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Recurrente\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Recurrente\\Laravel\\RecurrenteServiceProvider"
            ],
            "aliases": {
                "Recurrente": "Recurrente\\Laravel\\Facades\\Recurrente"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
